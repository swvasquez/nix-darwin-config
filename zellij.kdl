// An agent in the sandbox on the left, host shell in the repo on the right.
// Started via `just sbx-agent [agent]`, which passes the agent in SBX_AGENT.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="sandbox" focus=true {
        pane split_direction="vertical" {
            // Run through sh so SBX_AGENT expands on the host.
            pane name="agent" command="sh" {
                args "-c" "sbx exec -it nix-darwin-config bash -lc \"$SBX_AGENT; exec bash -l\""
            }
            pane name="shell"
        }
    }
}
